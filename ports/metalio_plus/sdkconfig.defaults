# CPYOS Metalio E-INK4 Plus — ESP-IDF 6.1 defaults.
# Set the target first: idf.py --preview set-target esp32s31
#
# Hardware facts cross-checked against the reference firmware's board config
# (kiikoread-rc110 boards/metalio47/sdkconfig.defaults) and the vendor BSP sources
# vendored under components/cpyos_metalio_bsp/vendor/: 16 MB DIO-80 flash,
# 16 MB Octal PSRAM at 200 MHz, 320 MHz CPU.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Wi-Fi/LWIP buffers come from PSRAM so the internal heap stays available for
# panel DMA and the 45 KB-class contiguous blocks CPYOS's TLS path needs.
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# The S31 target is experimental in IDF 6.1.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x2000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_plus_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# Reading is render-bound; the reference firmware ships PERF for the same panel.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 1 kHz tick: the vendor TPS65185 power-on path polls PGOOD in milliseconds, and
# a 100 Hz tick rounds every wait up to 10 ms.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
# UTF-8 long filenames reach the UI and fopen(); the on-disk LFN stays UTF-16.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
# Phase 0 bench console: the e4plus USB port is USB-Serial/JTAG. UART0 remains
# available on the header, but the automated host needs stdin over USB so the
# shell's `putfile`/`plugindemo` path works without a second adapter.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# USB mass-storage class (serial console `usbmsc on`)
CONFIG_TINYUSB_MSC_ENABLED=y

# BLE HID host (central) for the page-turner feature.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# kiikoread's metalio47 profile: trim the NimBLE buffers to a single HID
# central. The defaults ask for 8 CCCDs, a 256-byte ATT MTU and 24 MSYS/ACL
# buffers, which is several KB of internal RAM this board cannot spare while
# Wi-Fi, TLS and the AI-voice/4G workers are resident.
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=100
# kiikoread's metalio47 profile keeps NimBLE's host allocations in PSRAM and
# gives the host an 8 KiB stack; the internal pool is already shared by Wi-Fi,
# TLS and the AI-voice/4G workers. The runtime probe in BleInput rejects a host
# whose allocator is not actually external.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# WebSocket upload server on port 81 (Calibre plugin / fast uploads).
CONFIG_HTTPD_WS_SUPPORT=y

# Use the source TLSF: the ROM copy is only patched by a constructor
# that runs after esp_ipc_init, which corrupts the heap before the IPC tasks
# are created on ESP32-S31.
CONFIG_HEAP_TLSF_USE_ROM_IMPL=y

# CPYOS does not authenticate TLS peers (the reference build calls
# SecureClient::setInsecure); esp-tls refuses to run without a CA otherwise.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# mbedTLS/PSA allocations come from PSRAM: the internal heap bottoms out at
# ~3.5 KB during a handshake and PSA then fails with INSUFFICIENT_MEMORY.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Hardware AES must stay off: esp-aes allocates DMA-capable internal bounce
# buffers (8 KB in + 8 KB out per record) for PSRAM-backed TLS data, which
# exhausts the internal heap during chain downloads (cover + chapters) and also
# starves the SDMMC DMA path ("allocate_dma_buf: not enough mem").
# With EXTERNAL_MEM_ALLOC the TLS buffers are in PSRAM, so every record would
# take the bounce path. At 320 MHz software AES is not slower.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_GCM=n
# Hardware SHA/HMAC are off for the same reason as AES: the esp_sha PSA driver
# allocates every multipart hash context (and HMAC opad) from DMA-capable
# internal RAM, of which only a few kilobytes are free while Wi-Fi is up. The
# measured failure was psa_hash_setup() == -141 (PSA_ERROR_INSUFFICIENT_MEMORY)
# during ServerKeyExchange. Software SHA/HMAC keeps TLS off the DMA pool.
CONFIG_MBEDTLS_HARDWARE_SHA=n

# Native ELF plugin runtime (Phase 0 POC).
# The loader runs app-style ELFs from PSRAM; shared-object mode is off until the
# C ABI and unload path are proven. Keep the curated libc table for the hello
# plugin (printf/sleep); do not expose raw lwIP or IDF internals.
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=n
CONFIG_ELF_LOADER_LIBC_SYMBOLS=y
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=n
CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS=n
CONFIG_ELF_LOADER_NUMBER_SYMBOLS=8
