+void recordGrayRect(const int x, const int y, const int w, const int h) {
+  if (w <= 0 || h <= 0) return;
+  int nx = x;
+  int ny = y;
+  int nw = w;
+  int nh = h;
+  // Merge any touching/overlapping rectangle, then restart the scan because the
+  // merged box may now touch another entry.
+  bool merged = true;
+  while (merged) {
+    merged = false;
+    for (int i = 0; i < g_grayRectCount; ++i) {
+      GrayRect& r = g_grayRects[i];
+      if (nx > r.x + r.w || nx + nw < r.x || ny > r.y + r.h || ny + nh < r.y) continue;
+      const int x0 = std::min(nx, r.x);
+      const int y0 = std::min(ny, r.y);
+      const int x1 = std::max(nx + nw, r.x + r.w);
+      const int y1 = std::max(ny + nh, r.y + r.h);
+      nx = x0;
+      ny = y0;
+      nw = x1 - x0;
+      nh = y1 - y0;
+      g_grayRects[i] = g_grayRects[--g_grayRectCount];
+      merged = true;
+      break;
+    }
+  }
+  if (g_grayRectCount < kMaxGrayRects) {
+    g_grayRects[g_grayRectCount++] = {nx, ny, nw, nh};
+  } else {
+    // Too fragmented: one bounding box is cheaper than dropping a region.
+    int x0 = g_grayRects[0].x;
+    int y0 = g_grayRects[0].y;
+    int x1 = x0 + g_grayRects[0].w;
+    int y1 = y0 + g_grayRects[0].h;
+    for (int i = 1; i < g_grayRectCount; ++i) {
