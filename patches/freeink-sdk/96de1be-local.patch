+  assert(waitCalls == waits + 1);
+  assert(freeink::epdiyLcdScanPending());
+  driver.displayFinish(bus, fb);
+  assert(!freeink::epdiyLcdScanPending());
+  assert(prefillLast == 32);  // restored
