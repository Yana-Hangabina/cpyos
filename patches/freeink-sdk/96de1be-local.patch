+static void clip_rect(EpdRect* r, int w, int h) {
+    if (r->x < 0) {
+        r->width += r->x;
+        r->x = 0;
+    }
+    if (r->y < 0) {
+        r->height += r->y;
+        r->y = 0;
+    }
+    if (r->x + r->width > w) r->width = w - r->x;
+    if (r->y + r->height > h) r->height = h - r->y;
